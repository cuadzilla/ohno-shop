---
import Layout from '../../layouts/Layout.astro';
import Price from '../../components/Price.astro';
import SoldBadge from '../../components/SoldBadge.astro';
import { getArtworks } from '../../lib/sanity.js';
import { imageUrl, imageSrcSet, imageSize } from '../../lib/images.js';
import { withBase } from '../../lib/paths.js';

export async function getStaticPaths() {
  const artworks = await getArtworks();
  return artworks.map((a) => ({ params: { slug: a.slug }, props: { art: a } }));
}

const { art } = Astro.props;
const snipcartKey = import.meta.env.SNIPCART_PUBLIC_KEY;

// Snipcart crawls this exact URL to verify the price, so it must be the
// public, absolute address of THIS page.
const pageUrl = new URL(withBase(`/art/${art.slug}/`), Astro.site).href;

const [first, ...rest] = [art.image, ...(art.gallery ?? [])].filter(Boolean);
const socialImage = imageUrl(art.image, { width: 1200 });
---
<Layout title={art.title} description={art.description?.split('\n')[0]} image={socialImage}>
  <p class="mb-6 text-sm">
    <a href={withBase('/')} class="text-stone-600 hover:text-stone-900">&larr; All pieces</a>
  </p>

  <div class="lg:grid lg:grid-cols-2 lg:gap-x-12">
    {first && (
      <img
        src={imageUrl(first, { width: 1200 })}
        srcset={imageSrcSet(first, [600, 900, 1200, 1600])}
        sizes="(min-width: 1024px) 50vw, 100vw"
        alt={art.title}
        width={imageSize(first).width}
        height={imageSize(first).height}
        class="h-auto w-full bg-stone-200 lg:col-start-1 lg:row-start-1"
      />
    )}

    <div class="mt-6 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:self-start lg:sticky lg:top-6">
      <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">{art.title}</h1>
      <div class="mt-3">
        {art.sold ? <SoldBadge /> : <Price price={art.price} class="text-xl text-stone-800" />}
      </div>

      {art.description && (
        <p class="mt-6 whitespace-pre-line leading-relaxed text-stone-700">{art.description}</p>
      )}

      {!art.sold && (
        <div class="mt-8">
          {snipcartKey ? (
            <button
              type="button"
              class="snipcart-add-item w-full rounded-full bg-stone-900 px-6 py-3 font-medium text-white hover:bg-stone-700 sm:w-auto"
              data-item-id={art._id}
              data-item-name={art.title}
              data-item-price={art.price}
              data-item-url={pageUrl}
              data-item-image={imageUrl(art.image, { width: 600, height: 600 })}
              data-item-description={art.description || ''}
              data-item-max-quantity="1"
            >
              Add to cart
            </button>
          ) : (
            <p class="text-sm italic text-stone-500">Cart not configured yet (set SNIPCART_PUBLIC_KEY).</p>
          )}
        </div>
      )}
    </div>

    {rest.length > 0 && (
      <div class="mt-6 space-y-6 lg:col-start-1 lg:row-start-2 lg:mt-6">
        {rest.map((img, i) => (
          <img
            src={imageUrl(img, { width: 1200 })}
            srcset={imageSrcSet(img, [600, 900, 1200, 1600])}
            sizes="(min-width: 1024px) 50vw, 100vw"
            alt={`${art.title}, photo ${i + 2}`}
            width={imageSize(img).width}
            height={imageSize(img).height}
            loading="lazy"
            class="h-auto w-full bg-stone-200"
          />
        ))}
      </div>
    )}
  </div>
</Layout>
